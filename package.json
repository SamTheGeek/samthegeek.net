{
  "name": "samthegeek.net",
  "type": "module",
  "version": "1.0.1",
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-latest-redirect.mjs && npm run test:data && astro build && node scripts/verify-build-artifacts.mjs",
    "preview": "astro preview",
    "test": "node --test \"tests/unit/**/*.test.mjs\" \"tests/data/**/*.test.mjs\"",
    "test:data": "node --test \"tests/data/**/*.test.mjs\"",
    "test:dist": "node --test \"tests/dist/**/*.test.mjs\"",
    "test:e2e": "npm run build && npm run test:dist && playwright test",
    "test:e2e:ci": "playwright test",
    "postinstall": "node scripts/postinstall.mjs",
    "setup": "bash scripts/setup_repo.sh",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.10",
    "@netlify/blobs": "^11.1.6",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "exifr": "^7.1.3",
    "sharp": "^0.35.5"
  }
}

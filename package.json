{
  "name": "samthegeek.net",
  "type": "module",
  "version": "1.0.1",
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-latest-redirect.mjs && node scripts/run-tests.mjs && astro build && node scripts/verify-build-artifacts.mjs",
    "preview": "astro preview",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "npm run build && npx playwright test",
    "postinstall": "node scripts/postinstall.mjs",
    "setup": "bash scripts/setup_repo.sh",
    "astro": "astro",
    "test:e2e:ci": "npx playwright test --project=chromium --reporter=line"
  },
  "dependencies": {
    "@astrojs/netlify": "^7.0.8",
    "@netlify/blobs": "^10.7.4",
    "astro": "^6.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "exifr": "^7.1.3",
    "sharp": "^0.34.5"
  }
}

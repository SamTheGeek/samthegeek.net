---
import { Image } from 'astro:assets';
import Lightbox from './Lightbox.astro';

interface Props {
  title: string;
  images: Array<{
    src: string;
    webpSrc?: string;
    width?: number;
    height?: number;
    alt: string;
    exif?: {
      date?: string;
      camera?: string;
      lens?: string;
      focalLength?: string;
      aperture?: string;
      shutterSpeed?: string;
      iso?: string;
      latitude?: number;
      longitude?: number;
      location?: string;
      locationEn?: string;
    };
  }>;
}

const { title, images } = Astro.props;

// A panorama is a stitched/ultra-wide frame - far wider than any regular
// landscape photo. The widest ordinary shot in these galleries is 16:9 (1.78),
// while the panoramas run from 3.6:1 up to 6.7:1, so 2:1 separates them
// cleanly. Panoramas get a tile two columns wide; photos flow in beside them.
const PANORAMA_ASPECT_RATIO = 2;
const isPanorama = (image: Props['images'][number]) =>
  Boolean(image.width && image.height && image.width / image.height >= PANORAMA_ASPECT_RATIO);

// Masonry geometry. The grid's rows are a fine slice of one column's width
// (see --row-unit), which lets each tile's height be stated as a whole number
// of rows worked out from its aspect ratio - so photos keep their proportions
// while stacking freely, and a tile can be two columns wide without forcing a
// break in the flow.
//
// ROW_STEPS is how many rows make up one column width. GAP_ROWS is the tile
// gap measured in those rows; the gap is a fixed 4px while a row scales with
// the column, so it can only be approximated. The leftover is a pixel or two,
// which `object-fit: cover` absorbs rather than showing as an uneven gap.
const ROW_STEPS = 200;
const GAP_ROWS = 2;

const rowSpan = (image: Props['images'][number], columns: number) => {
  const ratio = (image.height ?? 800) / (image.width ?? 1200);
  // A tile n columns wide is n column widths plus the gaps it swallows.
  const tileWidthInRows = columns * ROW_STEPS + (columns - 1) * GAP_ROWS;
  return Math.max(1, Math.round(ratio * tileWidthInRows) + GAP_ROWS);
};
---

<div class="gallery-page">
  <div class="gallery-grid">
    {images.map((image, index) => {
      // First 6 images are likely above the fold - prioritize them
      const isAboveFold = index < 6;
      const panorama = isPanorama(image);
      const spans = panorama
        ? `--row-span:${rowSpan(image, 1)};--row-span-wide:${rowSpan(image, 2)}`
        : `--row-span:${rowSpan(image, 1)}`;
      return (
        <div
          class:list={['gallery-item', { 'gallery-item-panorama': panorama }]}
          style={spans}
        >
          <Image
            src={image.webpSrc ?? image.src}
            alt={image.alt}
            width={image.width ?? 1200}
            height={image.height ?? 800}
            widths={panorama ? [800, 1200, 1600, 2000] : [400, 800, 1200]}
            sizes={panorama
              ? "(max-width: 1280px) calc(100vw - 100px), calc((100vw - 350px) * 0.67)"
              : "(max-width: 768px) calc(100vw - 0.5rem), (max-width: 1280px) calc(50vw - 0.375rem), calc(33vw - 0.25rem)"}
            loading={isAboveFold ? "eager" : "lazy"}
            decoding={isAboveFold ? "sync" : "async"}
            fetchpriority={index === 0 ? "high" : undefined}
            data-full-src={image.webpSrc ?? image.src}
            data-exif-date={image.exif?.date}
            data-exif-camera={image.exif?.camera}
            data-exif-lens={image.exif?.lens}
            data-exif-focal-length={image.exif?.focalLength}
            data-exif-aperture={image.exif?.aperture}
            data-exif-shutter-speed={image.exif?.shutterSpeed}
            data-exif-iso={image.exif?.iso}
            data-exif-latitude={image.exif?.latitude}
            data-exif-longitude={image.exif?.longitude}
            data-exif-location={image.exif?.location}
            data-exif-location-en={image.exif?.locationEn}
          />
        </div>
      );
    })}
  </div>
</div>

<Lightbox />

<style>
  /* The row unit below is a slice of one column's width, so the grid needs to
     know that width as a length: an inline-size container makes 100cqw the
     grid's own width. */
  .gallery-page {
    container-type: inline-size;
  }

  .gallery-grid {
    --tile-gap: 0.25rem;
    --gallery-columns: 3;
    /* One column width, and the fine row slice tiles are measured in. Rows are
       gapless - each tile carries the gap as its own padding - so a tile's
       height is exactly its row span, which is what makes the arithmetic in the
       frontmatter come out. */
    --column-width: calc(
      (100cqw - (var(--gallery-columns) - 1) * var(--tile-gap)) / var(--gallery-columns)
    );
    --row-unit: calc(var(--column-width) / 200);
    display: grid;
    grid-template-columns: repeat(var(--gallery-columns), minmax(0, 1fr));
    grid-auto-rows: var(--row-unit);
    /* Dense packing is what lets a photo sit beside a two-column panorama
       instead of leaving the rest of the row empty. */
    grid-auto-flow: row dense;
    column-gap: var(--tile-gap);
    row-gap: 0;
    margin-top: 0;
  }

  .gallery-item {
    box-sizing: border-box;
    padding-bottom: var(--tile-gap);
    grid-row-end: span var(--row-span);
    overflow: hidden;
    background: #f5f5f5;
    transition: opacity 0.2s;
  }

  .gallery-item:hover {
    opacity: 0.9;
  }

  /* Panoramas run two columns wide, so an ultra-wide frame is not squeezed into
     a single column's worth of pixels. At two columns that is the full width. */
  .gallery-item-panorama {
    grid-column-end: span 2;
    grid-row-end: span var(--row-span-wide);
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    /* The row grid quantises each tile to within a pixel or two of the photo's
       true height; cover soaks that up instead of leaving an uneven gap. */
    object-fit: cover;
    display: block;
    cursor: pointer;
  }

  @media (max-width: 1280px) {
    .gallery-grid {
      --gallery-columns: 2;
    }
  }

  @media (max-width: 768px) {
    .gallery-grid {
      --gallery-columns: 1;
    }

    /* Nothing to span at one column - the panorama is a normal tile. */
    .gallery-item-panorama {
      grid-column-end: span 1;
      grid-row-end: span var(--row-span);
    }
  }
</style>
